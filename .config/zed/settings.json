{
  "cursor_shape": "underline",
  "cursor_blink": false,
  "buffer_font_family": ".ZedMono",
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always"
  },
  "ui_font_size": 14,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Hard",
    "dark": "One Dark"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false
  },
  "project_panel": {
    "entry_spacing": "standard"
  },
  "tabs": {
    "file_icons": true
  },
  "tab_bar": {
    "show": false
  },
  "soft_wrap": "editor_width",
  "format_on_save": "on",
  "show_whitespaces": "selection",
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "scrollbar": {
    "show": "never"
  }
}
